setvar Unstack 1

## Do not edit below
@clearignore
unsetvar DistroChest
unsetvar LootChest

##List handling
removelist 'SaveWorld'
removelist 'ItemList'
removelist 'vertical'
removelist 'horizontal'
removelist 'stufftodistro'

createlist 'ItemList'
createlist 'stufftodistro'
createlist 'vertical'
createlist 'horizontal'
clearsysmsg 

overhead '>> SET LOOTCHEST <<' 44
@setvar! LootChest
pause 25
overhead '-->> SET DISTRO CHEST<<--' 44
@setvar! DistroChest
pause 25

if not varexist LootChest 
    overhead '[SCRIPT STOPPED]' 38
    stop
endif

@clearignore

## Unstacking

if Unstack = 1
    sysmsg 'Unstacking' 44
    ## Unstack cores
    if counttype 'aspect core|chroma core' LootChest > 1
        while findtype 'aspect core' LootChest as pick
            lift pick 
            drop LootChest 140 0 0
            while queued
                pause 75
            endwhile
            pause 650
            @ignore pick
        endwhile
    endif
    
    
    ## Distils
    if counttype 'flask' LootChest > 1
        while findtype 'flask' LootChest as pick
            lift pick 
            drop LootChest 140 0 0
            while queued
                pause 75
            endwhile
            pause 650
            @ignore pick
        endwhile
    endif
    
    ## Unstack scrolls
    if counttype 'scroll of calling' LootChest > 1
        while findtype 'scroll of calling' LootChest as pick
            lift pick
            drop LootChest 140 0 0
            while queued
                pause 75
            endwhile
            pause 650
            @ignore pick
        endwhile
    else
        sysmsg 'Nothing stacked'
    endif
    ## MCD
    if counttype 'Book of Truth' LootChest > 1
        while findtype 'Book of Truth' LootChest as pick
            lift pick
