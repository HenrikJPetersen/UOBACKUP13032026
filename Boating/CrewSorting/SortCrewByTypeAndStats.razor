## Movementspeed:
## Pilgrim, Navigator, Sea dog, Sailor, Merchant    
if not varexist speedcrewchest
    setvar speedcrewchest
elseif not find speedcrewchest
    overhead 'speedcrewchest NA'
    setvar speedcrewchest
endif

## Pilgrims
if not varexist pilgrimchest
    setvar pilgrimchest
elseif not find pilgrimchest
    overhead 'pilgrimchest NA'
    setvar pilgrimchest
endif

