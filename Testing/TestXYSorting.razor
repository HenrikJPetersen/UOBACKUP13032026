## 1st Circle

if not listexists firstcircle
    createlist firstcircle
endif

if findtypelist firstcircle 19976|19977|19978|19979|19980  backpack any
    overhead 'Found runes from first circle'
endif

while findtype 19980 searchcontainer as rune
    if amount_fortify = 0
        lift rune 500
    else
        lift rune amount_fortify
    endif
    drop timedungeonsatchel 83 65 0
    while queued
        pause 75
    endwhile
endwhile

while findtype 19979 searchcontainer as rune
    if amount_magicward = 0
        lift rune 500
    else
        lift rune amount_magicward
    endif
    drop timedungeonsatchel 43 65 0
    while queued
        pause 75
    endwhile
endwhile

while findtype 19978 searchcontainer as rune
    if amount_ironflesh = 0
        lift rune 500
    else
        lift rune amount_ironflesh
    endif
    drop timedungeonsatchel 53 65 0
    while queued
        pause 75
    endwhile
endwhile

while findtype 19977 searchcontainer as rune
    if amount_mend = 0
        lift rune 500
    else
        lift rune amount_mend
    endif
    drop timedungeonsatchel 73 65 0
    while queued
        pause 75
    endwhile
endwhile

while findtype 19976 searchcontainer as rune
    getlabel rune myrunelabel
    if 'crafted' in myrunelabel
        ##Sort in main backpack
    else
        if amount_knock = 0
            lift rune 500
        else
            lift rune amount_knock
        endif
        drop timedungeonsatchel 43 65 0
        while queued
        pause 75
    endwhile
    endif
    endwhile
