@setvar! amount_knock 10
#19977 MendRune
@setvar! amount_mend 10
#19978 IronfleshRune
@setvar! amount_ironflesh 10
#19979 MagicWardRune
@setvar! amount_magicward 10
#19979 FortifyrationsRune
