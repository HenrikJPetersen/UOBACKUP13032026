if findtype "archery codex" backpack as archCodex
    getlabel archCodex archCodexLabel
    //wait 100
    if 'Fowling' in archCodexLabel
        overhead '[Fowling Active]' 66
    elseif mana < 3
        overhead '[No Mana]' 33
    else 
        yell '[ArcheryAmmunition2'
        overhead '[Fowling Activated]' 66
    endif
else 
    overhead 'Codex not found!' 33
    yell '[ArcheryAmmunition2'
endif