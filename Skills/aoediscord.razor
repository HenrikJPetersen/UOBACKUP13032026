 ## Setting spamtimers for notifications.
if not timerexists spamtimerbombs
    createtimer spamtimerbombs
    settimer spamtimerbombs 1000
else
    settimer spamtimerbombs 1000
endif
if listexists bomblistnotification
    clearlist bomblistnotification
else
    createlist bomblistnotification
endif
@setvar! autopot 1

while not dead 
    if not cooldown discord
        while targetexists 
        endwhile
        skill 'discord'
        wft 600
        target self
    endif
    
    ## Healing
    if skill "healing" > 0 and not bandaging and hp < maxhp
        hotkey 'Bandage Self'
        wait 500
    endif
    if cooldown bandage > 5 and hp < 50 and not cooldown "heal potion" and skill "healing" > 0
        potion 'heal'
    endif
    if autopot = 1
        if not findbuff 'Strength'
            dclicktype 3849 backpack 0
            pause 600
        endif
        if not findbuff 'Agility'
            potion 'Agility'
            pause 600
        endif
        if not findbuff 'Magic resist potion'
            potion 'Nightsight'
            pause 600
        endif
    endif  
    if findtypelist bomblistnotification '38226|38213|38215|38224|standing stone|43730' ground -1 -1 5 and timer spamtimerbombs > 1000
        foreach bomb in bomblistnotification
            for 1
                overhead '>>☻☻ BOMB ☻☻<<' 2263 bomb
                overhead '>>☻☻ BOMB ☻☻<<' 33 bomb
                overhead '☻☻☻☻☻☻☻☻☻☻☻☻☻☻' 2263 bomb
            endfor
            settimer spamtimerbombs 0
        endfor
    endif
endwhile